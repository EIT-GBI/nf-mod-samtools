config {
    testsDir "."
    workDir ".nf-test"
    configFile "nextflow.config"

    // Reads SAM/BAM/CRAM contents in assertions. BAM md5s are not stable on
    // their own: samtools records the full command line (including -@ task.cpus)
    // in an @PG header line, so the file checksum moves whenever the config
    // does. This plugin checksums the reads only.
    plugins {
        load "nft-bam@0.7.0"
    }
}
