nextflow_process {

    name "Test SAMTOOLS_FASTQ"
    script "../main.nf"
    process "SAMTOOLS_FASTQ"

    // the module is for converting unaligned BAM back to FASTQ
    def TEST_BAM = 'file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/illumina/bam/test.unaligned.bam", checkIfExists: true)'

    test("SAMTOOLS_FASTQ - stub - wiring and output names") {

        options "-stub-run"

        when {
            process {
                """
                input[0] = [[id:'test'], ${TEST_BAM}]
                """
            }
        }

        then {
            assert process.success
            assert process.out.reads
        }
    }

    test("SAMTOOLS_FASTQ - converts an unaligned BAM to FASTQ") {

        config "../../tests.config"

        when {
            process {
                """
                input[0] = [[id:'test'], ${TEST_BAM}]
                """
            }
        }

        then {
            assert process.success

            def lines = path(process.out.reads[0][1]).linesGzip

            // four lines per record, and the FASTQ structure should hold
            assert lines.size() % 4 == 0
            assert lines[0].startsWith('@')
            assert lines[2] == '+'
            // gzip compressing stdin records no mtime, so the file is stable
            assert snapshot(process.out.reads).match()
        }
    }

    test("SAMTOOLS_FASTQ - fails when samtools fails, even though gzip succeeds") {

        config "../../tests.config"

        when {
            process {
                // A SAM with a corrupt record after four good ones. samtools
                // exits 1 on the parse error; gzip still writes a well-formed
                // .fastq.gz of whatever reached it and exits 0. Without
                // pipefail the task took gzip's status and passed with that
                // file (EIT-GBI/nf-dnaseq#19).
                """
                input[0] = [[id:'test'], file("${moduleTestDir}/data/corrupt_record.sam", checkIfExists: true)]
                """
            }
        }

        then {
            assert process.failed
            // by name, so the test cannot pass on a failure of something else,
            // such as the harness itself not compiling
            assert process.trace.failed()*.name == ['SAMTOOLS_FASTQ (test)']
        }
    }
}
