nextflow_process {

    name "Test SAMTOOLS_CONSENSUS"
    script "../main.nf"
    process "SAMTOOLS_CONSENSUS"

    // nf-core sarscov2 test set: coordinate-sorted, aligned to MT192765.1
    def TEST_BAM = 'file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam", checkIfExists: true)'

    test("SAMTOOLS_CONSENSUS - stub - wiring and output names") {

        options "-stub-run"

        when {
            process {
                """
                input[0] = [[id:'test'], ${TEST_BAM}]
                """
            }
        }

        then {
            assert process.success
            assert process.out.fasta
        }
    }

    test("SAMTOOLS_CONSENSUS - builds a consensus for the reference contig") {

        config "../../tests.config"

        when {
            process {
                """
                input[0] = [[id:'test'], ${TEST_BAM}]
                """
            }
        }

        then {
            assert process.success

            def lines   = path(process.out.fasta[0][1]).readLines()
            def headers = lines.findAll { it.startsWith('>') }

            // one record, named after the contig the reads were aligned to
            assert headers == ['>MT192765.1']
            assert lines.size() > 1
            // plain text with no timestamps, so the file is safe to snapshot whole
            assert snapshot(process.out.fasta).match()
        }
    }
}
