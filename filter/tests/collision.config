// params.filter.* plus an -e in ext.args: samtools would honour only the last
// -e and silently drop the other filter, so SAMTOOLS_FILTER refuses to run.
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: SAMTOOLS_FILTER {
        container = 'ghcr.io/eit-gbi/nf-mod-samtools:latest'
        cpus      = 1
        ext.args  = "-e 'length(seq) >= 150'"
    }
}
