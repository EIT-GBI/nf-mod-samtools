// Config for the SAMTOOLS_FILTER tests that run samtools for real.
//
// conf/module.config pins :v0.0.0, which only exists once this module is
// released, so the tests track :latest instead - the same reason the consuming
// pipeline carries a `dev` profile.
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'

process {
    withName: SAMTOOLS_FILTER {
        container = 'ghcr.io/eit-gbi/nf-mod-samtools:latest'
        cpus      = 1
    }
}
