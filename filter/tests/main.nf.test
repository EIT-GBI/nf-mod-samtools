nextflow_process {

    name "Test SAMTOOLS_FILTER"
    script "../main.nf"
    process "SAMTOOLS_FILTER"

    test("SAMTOOLS_FILTER - stub - wiring and output names") {

        options "-stub-run"

        when {
            process {
                """
                input[0] = [[id:'test'], file("https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam", checkIfExists: true)]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
